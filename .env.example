# Paystack (get keys from Paystack Dashboard -> Settings -> API Keys & Webhooks)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Subscription & retention configuration
PLAN_PRICE_PESEWAS=2000
TRIAL_DAYS=30
RETENTION_DAYS=90

# Public site URL (used in generated links and CORS)
SITE_URL=

# Admin panel passcode (leave blank in preview to use first-run inline setup)
ADMIN_PASSCODE=

# Optional Email & SMS notifications (Resend & Arkesel)
RESEND_API_KEY=
EMAIL_FROM=
ARKESEL_API_KEY=
SMS_SENDER_ID=
