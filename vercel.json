{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/server/(.*)", "destination": "/api/index.js" },
    { "source": "/data/(.*)", "destination": "/api/index.js" },
    { "source": "/supabase/(.*)", "destination": "/api/index.js" },
    { "source": "/.env(.*)", "destination": "/api/index.js" },
    { "source": "/package.json", "destination": "/api/index.js" },
    { "source": "/package-lock.json", "destination": "/api/index.js" },
    { "source": "/vercel.json", "destination": "/api/index.js" },
    { "source": "/pro/(.*)", "destination": "/api/index.js" },
    { "source": "/w/(.*)", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 8 * * *"
    }
  ]
}
