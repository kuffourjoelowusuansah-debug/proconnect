{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/server/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/data/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/supabase/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/pro/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/w/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/about",
      "dest": "/index.html"
    },
    {
      "src": "/privacy",
      "dest": "/index.html"
    },
    {
      "src": "/terms",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 8 * * *"
    }
  ]
}
